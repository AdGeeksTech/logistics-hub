# All three values are required to enable online sending. Without them, users
# can prepare and download an inquiry. Never commit real credentials.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=

# Admin at /admin (car listings and site texts). Use a long, unique password;
# everyone with it can publish to the site. Changing it signs everyone out.
ADMIN_PASSWORD=
# Optional: sign sessions with a separate secret instead of the password.
ADMIN_SESSION_SECRET=

# Production storage, normally added by connecting Neon (Postgres) and Vercel
# Blob to the project in Vercel. Without them, local development stores
# listings and photos in .data/ (or LOCAL_DATA_DIR) instead.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
LOCAL_DATA_DIR=
